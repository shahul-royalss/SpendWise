# Copy to .env and adjust. Every value is optional for local development.

# Never enable in production.
DJANGO_DEBUG=False

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Left empty, a random key is generated on every start (sessions reset on restart).
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with scheme) when served over HTTPS, e.g. https://spendwise.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to True behind HTTPS: SSL redirect, secure cookies and HSTS.
DJANGO_SECURE_HTTPS=False

# Decides which month "today" belongs to.
DJANGO_TIME_ZONE=Asia/Kolkata

# Path of the SQLite database file. Defaults to db.sqlite3 in the project folder.
SQLITE_PATH=

# Optional. Only needed if you run collectstatic.
DJANGO_STATIC_ROOT=

# Symbol used when formatting money.
CURRENCY_SYMBOL=₹
